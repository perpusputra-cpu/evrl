# MISTRAL_API_KEY: Mistral AI Provider API Key
MISTRAL_API_KEY=""
MISTRAL_MODEL="open-mistral-nemo"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional alternative fast AI provider
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# SESSION_SIGNING_SECRET: Secret used to sign anonymous workspace session cookies
SESSION_SIGNING_SECRET="dev_secret_key_ecobrick_research_lab_2026"

# RECAPTCHA_SITE_KEY and RECAPTCHA_SECRET_KEY: Optional reCAPTCHA keys for abuse prevention
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# BLOB_READ_WRITE_TOKEN: Optional Vercel Blob storage token
BLOB_READ_WRITE_TOKEN=""

# CLOUDFLARE TURNSTILE CONFIGURATION
# VITE_TURNSTILE_SITE_KEY: Public Turnstile site key exposed to React client
VITE_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET: Secret Turnstile key used strictly server-side for token verification (Never prefix with VITE_)
TURNSTILE_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

